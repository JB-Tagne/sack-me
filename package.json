{
  "name": "sack-me",
  "private": true,
  "version": "1.0.0",
  "description": "Sack Me! — adventure game focused on project management and data governance",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "export:sql": "node ./node_modules/tsx/dist/cli.mjs scripts/exportTsToSql.ts",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:e2e:install": "node ./node_modules/@playwright/test/cli.js install chromium",
    "quality:report": "node ./scripts/monthlyQualityReport.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
